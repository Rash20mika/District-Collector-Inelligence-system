# Copy these settings into .env and replace the example values.
GROQ_API_KEY=replace_with_your_groq_api_key
WEB_USERNAME=collector_username
WEB_PASSWORD=replace_with_a_long_unique_password
PA_USERNAME=personal_assistant_username
PA_PASSWORD=replace_with_a_different_long_unique_password
WEB_SESSION_SECRET=replace_with_a_random_secret

# Optional: enable user-provided link extraction and RSS search refresh.
TAVILY_API_KEY=
